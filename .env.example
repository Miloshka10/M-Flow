# Reference for process environment only; the app does not load this file.
# Keep real credentials in private host settings. Never commit a filled copy.
M_FLOW_TEACHER_CODE=
M_FLOW_PUBLIC_URL=https://m-flow-4tjw.onrender.com
# smtp, brevo or emailjs. No automatic fallback.
M_FLOW_MAIL_PROVIDER=smtp
M_FLOW_MAIL_HOST=
M_FLOW_MAIL_PORT=587
M_FLOW_MAIL_TLS=starttls
M_FLOW_MAIL_USER=
M_FLOW_MAIL_PASSWORD=
M_FLOW_MAIL_FROM=
# Brevo API key or EmailJS PRIVATE key. Different from an SMTP key.
M_FLOW_MAIL_API_KEY=
M_FLOW_MAIL_PUBLIC_KEY=
M_FLOW_MAIL_SERVICE_ID=
M_FLOW_MAIL_TEMPLATE_ID=
M_FLOW_OPERATOR_NAME=
M_FLOW_SUPPORT_EMAIL=
# Optional. A locally downloaded Ollama model. Blank keeps the assistant off.
M_FLOW_OLLAMA_MODEL=
M_FLOW_OLLAMA_PORT=11434
# Optional online demo. Store the API key in the hosting dashboard.
M_FLOW_CLOUD_DEMO=
M_FLOW_AI_PROVIDER=
M_FLOW_GROQ_MODEL=openai/gpt-oss-20b
M_FLOW_GROQ_API_KEY=
M_FLOW_CLOUD_DEMO_PASSWORD=
